{
  "$schema": "https://developer.microsoft.com/json-schemas/rush/v5/common-versions.schema.json",
  "preferredVersions": {
    "@types/react": "^17.0.37",
    "axe-core": "4.1.2",
    // Keep every package on one Electron binary. resolution-mode=lowest-direct can resolve a newly added
    // package to an older Electron, and CI only downloads and sandboxes one binary. Move this pin, and the
    // matching allowedAlternativeVersions entry below, when the repo bumps Electron.
    "electron": "44.4.5",
    "event-stream": "~4.0.1",
    "flatbuffers": "~1.12.0",
    "lint-staged": "^10.2.11",
    "immer": "9.0.6",
    "object-is": "1.0.2",
    "ssri": "^6.0.1",
    "tsutils": "~3.17.1",
    "typescript": "~5.6.2"
  },
  "allowedAlternativeVersions": {
    // Packages declare ^44.0.0; this lets the pin above coexist with that range.
    "electron": ["44.4.5"]
  }
}