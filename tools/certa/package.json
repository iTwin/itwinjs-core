{
  "name": "@itwin/certa",
  "version": "5.16.0-dev.12",
  "description": "A mocha-based integration test runner",
  "license": "MIT",
  "main": "bin/certa.js",
  "exports": {
    ".": "./bin/certa.js",
    "./callbacks": {
      "types": "./lib/callbacks.d.ts",
      "import": "./lib/callbacks.js",
      "require": "./lib/callbacks.js"
    },
    "./lib/*.js": "./lib/*.js",
    "./lib/*.d.ts": "./lib/*.d.ts",
    "./lib/*.js.map": "./lib/*.js.map",
    "./lib/*.d.ts.map": "./lib/*.d.ts.map",
    "./lib/*": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    },
    "./bin/*.js": "./bin/*.js",
    "./bin/*": "./bin/*.js",
    "./certa.schema.json": "./certa.schema.json",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "callbacks": ["lib/callbacks.d.ts"]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iTwin/itwinjs-core.git",
    "directory": "tools/certa"
  },
  "bin": {
    "certa": "./bin/certa.js"
  },
  "scripts": {
    "build": "tsc 1>&2",
    "clean": "rimraf -g lib .rush/temp/package-deps*.json",
    "lint": "eslint \"./src/**/*.ts\" 1>&2",
    "lint-deprecation": "eslint --fix -f visualstudio --no-inline-config -c ../../common/config/eslint/eslint.config.deprecation-policy.js \"./src/**/*.ts\"",
    "test": "",
    "docs": "",
    "cover": "",
    "postinstall": "npx playwright install chromium"
  },
  "keywords": [
    "Bentley",
    "iModel",
    "iTwin.js",
    "EC"
  ],
  "author": {
    "name": "Bentley Systems, Inc.",
    "url": "http://www.bentley.com"
  },
  "dependencies": {
    "canonical-path": "^1.0.0",
    "detect-port": "~1.3.0",
    "express": "catalog:runtime",
    "jsonc-parser": "~2.0.3",
    "lodash": "catalog:utilities",
    "mocha": "catalog:testing",
    "playwright": "catalog:testing",
    "source-map-support": "catalog:build",
    "yargs": "catalog:build"
  },
  "devDependencies": {
    "@itwin/build-tools": "workspace:*",
    "@itwin/eslint-plugin": "catalog:linting",
    "@types/detect-port": "~1.1.0",
    "@types/express": "catalog:runtime",
    "@types/lodash": "catalog:utilities",
    "@types/mocha": "catalog:testing",
    "@types/node": "catalog:build",
    "@types/yargs": "catalog:build",
    "electron": "catalog:electron",
    "eslint": "catalog:linting",
    "nyc": "catalog:testing",
    "rimraf": "catalog:build",
    "typescript": "catalog:build"
  },
  "peerDependencies": {
    "electron": ">=35.0.0 <46.0.0"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  }
}
