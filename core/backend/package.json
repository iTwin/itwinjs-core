{
  "name": "@itwin/core-backend",
  "version": "5.16.0-dev.9",
  "description": "iTwin.js backend components",
  "main": "lib/cjs/core-backend.js",
  "module": "lib/esm/core-backend.js",
  "typings": "lib/cjs/core-backend",
  "license": "MIT",
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "build": "npm run -s build:cjs && npm run -s build:esm && npm run -s copy:assets && npm run -s copy:test-assets && npm run -s copy:ecsqltestmdfiles",
    "build:cjs": "tsc 1>&2 --outDir lib/cjs",
    "build:esm": "tsc 1>&2 --module ES2022 --outDir lib/esm",
    "clean": "rimraf -g lib .rush/temp/package-deps*.json  ../../tools/internal/ios/core-test-runner/build ../../tools/internal/lib",
    "docs": "betools docs --json=../../generated-docs/core/core-backend/file.json --tsIndexFile=./core-backend.ts --onlyJson --excludeGlob=**/*.d.ts && npm run -s extract",
    "copy:assets": " npm run -s copy:assets:cjs && npm run -s copy:assets:esm",
    "copy:assets:cjs": "cpx \"./src/assets/**/*\" ./lib/cjs/assets",
    "copy:assets:esm": "cpx \"./src/assets/**/*\" ./lib/esm/assets",
    "copy:ecsqltestmdfiles": "cpx \"./src/test/ecsql/queries/*\" ./lib/cjs/test/ecsql/queries",
    "copy:config": "internal-tools copy-config",
    "copy:test-assets": "cpx \"./src/test/assets/**/*\" ./lib/cjs/test/assets",
    "cover": "nyc npm -s test",
    "extract": "betools extract --fileExt=ts --extractFrom=./src/test/example-code --recursive --out=../../generated-docs/extract",
    "extract-api": "betools extract-api --entry=core-backend",
    "lint": "eslint \"./src/**/*.ts\" 1>&2",
    "lint-fix": "eslint --fix -f visualstudio \"./src/**/*.ts\" 1>&2",
    "lint-deprecation": "eslint --fix -f visualstudio --no-inline-config -c ../../common/config/eslint/eslint.config.deprecation-policy.js \"./src/**/*.ts\"",
    "test": "mocha",
    "test:debug": "mocha --inspect-brk",
    "ios:bundle:tests": "TESTS_GLOB=./lib/esm/**/*.test.js vite build --mode development --config ../../tools/internal/ios/ios.vite.config.mts",
    "ios:copy:assets": "cpx \"./src/test/assets/**/*\" ../../tools/internal/lib/ios/assets/assets && cpx \"./src/assets/**/*\" ../../tools/internal/lib/ios/assets/assets",
    "ios:build:tests": "npm run -s build && npm run -s ios:bundle:tests && npm run -s ios:copy:assets",
    "ios:build:core-test-runner": "cd ../../tools/internal/ios/core-test-runner && xcrun xcodebuild -derivedDataPath ./build/DerivedData build CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY= CODE_SIGNING_REQUIRED=NO PROVISIONING_PROFILE_SPECIFIER= -scheme core-test-runner -arch arm64 -sdk iphonesimulator -configuration Debug",
    "ios:tests:simulator": "node scripts/runUnitTestsIosSimulator.mjs",
    "ios:all": "npm run ios:build:tests && npm run ios:build:core-test-runner && npm run ios:tests:simulator"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iTwin/itwinjs-core.git",
    "directory": "core/backend"
  },
  "keywords": [
    "Bentley",
    "BIM",
    "iModel",
    "digital-twin",
    "iTwin"
  ],
  "author": {
    "name": "Bentley Systems, Inc.",
    "url": "http://www.bentley.com"
  },
  "peerDependencies": {
    "@itwin/core-bentley": "workspace:*",
    "@itwin/core-common": "workspace:*",
    "@itwin/core-geometry": "workspace:*",
    "@itwin/core-quantity": "workspace:*",
    "@itwin/ecschema-metadata": "workspace:*",
    "@opentelemetry/api": "^1.0.4"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "//devDependencies": [
    "NOTE: All peerDependencies should also be listed as devDependencies since peerDependencies are not considered by npm install",
    "NOTE: All tools used by scripts in this package must be listed as devDependencies"
  ],
  "devDependencies": {
    "@itwin/build-tools": "workspace:*",
    "@itwin/core-bentley": "workspace:*",
    "@itwin/core-common": "workspace:*",
    "@itwin/core-geometry": "workspace:*",
    "@itwin/core-quantity": "workspace:*",
    "@itwin/ecschema-locaters": "workspace:*",
    "@itwin/ecschema-metadata": "workspace:*",
    "@itwin/ecsql-common": "workspace:*",
    "@itwin/eslint-plugin": "catalog:linting",
    "@itwin/object-storage-core": "catalog:imodels-clients",
    "@opentelemetry/api": "1.0.4",
    "@types/chai": "catalog:testing",
    "@types/chai-as-promised": "catalog:testing",
    "@types/deep-equal-in-any-order": "^1.0.4",
    "@types/fs-extra": "catalog:utilities",
    "@types/mocha": "catalog:testing",
    "@types/multiparty": "^0.0.31",
    "@types/node": "catalog:build",
    "@types/semver": "catalog:utilities",
    "@types/sinon": "catalog:testing",
    "@types/touch": "^3.1.2",
    "@types/ws": "catalog:types",
    "@xmldom/xmldom": "catalog:runtime",
    "chai": "catalog:testing",
    "chai-as-promised": "catalog:testing",
    "cpx2": "catalog:build",
    "deep-equal-in-any-order": "^2.0.6",
    "eslint": "catalog:linting",
    "internal-tools": "workspace:*",
    "mocha": "catalog:testing",
    "node-simctl": "catalog:testing",
    "nyc": "catalog:testing",
    "rimraf": "catalog:build",
    "sinon": "catalog:testing",
    "typescript": "catalog:build",
    "marked": "^14.1.3",
    "sql-formatter": "^15.4.6",
    "vite": "catalog:bundling"
  },
  "dependencies": {
    "@bentley/imodeljs-native": "5.16.21",
    "@itwin/object-storage-azure": "catalog:imodels-clients",
    "@azure/storage-blob": "catalog:runtime",
    "form-data": "^4.0.6",
    "fs-extra": "catalog:utilities",
    "json5": "^2.2.3",
    "linebreak": "^1.1.0",
    "multiparty": "^4.3.0",
    "semver": "catalog:utilities",
    "touch": "^3.1.0",
    "ws": "^7.5.11"
  },
  "nyc": {
    "extends": "./node_modules/@itwin/build-tools/.nycrc"
  }
}
