{
  "name": "@itwin/core-electron",
  "version": "5.13.0-dev.13",
  "description": "iTwin.js ElectronHost and ElectronApp",
  "license": "MIT",
  "scripts": {
    "build": "npm run -s build:cjs && npm run -s copy:test-assets",
    "build:cjs": "tsc 1>&2 --outDir lib/cjs",
    "copy:test-assets": "cpx \"./src/test/assets/**/*\" ./lib/cjs/test/assets",
    "clean": "rimraf -g lib .rush/temp/package-deps*.json",
    "docs": "betools docs --json=../../generated-docs/core/core-electron/file.json --tsIndexFile=./core-electron.ts --onlyJson",
    "extract-api": "betools extract-api --entry=core-electron",
    "lint": "eslint \"./src/**/*.ts\" 1>&2",
    "lint-deprecation": "eslint --fix -f visualstudio --no-inline-config -c ../../common/config/eslint/eslint.config.deprecation-policy.js \"./src/**/*.ts\"",
    "test": "",
    "test:integration": "npm run test:integration:backend && npm run test:integration:frontend",
    "test:integration:backend": "vitest run --config vitest.backend.config.mts",
    "test:integration:frontend": "vitest run --config vitest.frontend.config.mts",
    "cover": ""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iTwin/itwinjs-core.git",
    "directory": "core/electron"
  },
  "keywords": [
    "Bentley",
    "BIM",
    "iModel"
  ],
  "author": {
    "name": "Bentley Systems, Inc.",
    "url": "http://www.bentley.com"
  },
  "peerDependencies": {
    "@itwin/core-backend": "workspace:*",
    "@itwin/core-bentley": "workspace:*",
    "@itwin/core-common": "workspace:*",
    "@itwin/core-frontend": "workspace:*",
    "electron": ">=35.0.0 <44.0.0"
  },
  "devDependencies": {
    "@itwin/build-tools": "workspace:*",
    "@itwin/core-backend": "workspace:*",
    "@itwin/core-bentley": "workspace:*",
    "@itwin/core-common": "workspace:*",
    "@itwin/core-frontend": "workspace:*",
    "@itwin/eslint-plugin": "^6.0.0",
    "@itwin/vitest-browser-bridge": "workspace:*",
    "@types/node": "~20.17.0",
    "@vitest/browser": "^4.1.10",
    "cpx2": "^8.0.0",
    "electron": "^43.0.0",
    "eslint": "^9.31.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.6.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@openid/appauth": "^1.3.2",
    "username": "^7.0.0"
  }
}
