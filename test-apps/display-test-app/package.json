{
  "name": "display-test-app",
  "description": "Internal app for testing features of display system",
  "license": "UNLICENSED",
  "author": {
    "name": "Bentley Systems, Inc.",
    "url": "http://www.bentley.com"
  },
  "version": "1.8.0",
  "private": true,
  "scripts": {
    "build": "npm run -s build:frontend && npm run -s build:backend",
    "build:stats": "cross-env OUTPUT_STATS=TRUE npm run build",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build:frontend": "tsc && cross-env NODE_OPTIONS=--max_old_space_size=8192 vite build",
    "clean": "rimraf -g build lib .static-assets .rush/temp/package-deps*.json ios/imodeljs-test-app/build android/imodeljs-test-app/app/build android/imodeljs-test-app/app/src/main/assets",
    "docs": "",
    "lint": "eslint \"./src/**/*.ts\" 1>&2",
    "lint-fix": "eslint --fix -f visualstudio \"./src/**/*.ts\" 1>&2",
    "lint-deprecation": "",
    "start": "cross-env NODE_ENV=development run-p start:webserver start:electron",
    "start-no-sandbox": "cross-env NODE_ENV=development run-p start:webserver start:electron-no-sandbox",
    "start:electron": "electron ./lib/backend/DtaElectronMain.js --inspect --remote-debugging-port=9223",
    "start:electron-no-sandbox": "electron ./lib/backend/DtaElectronMain.js --inspect --remote-debugging-port=9223 --no-sandbox",
    "start:webserver": "cross-env NODE_ENV=development vite",
    "start:mobile": "cross-env NODE_ENV=development vite --host",
    "start:backend": "node --max-http-header-size=16000 lib/backend/WebMain.js",
    "start:servers": "run-p \"start:webserver\" \"start:backend\"",
    "test": "",
    "cover": "",
    "copy:config": "internal-tools copy-config",
    "build:mobile": "npm run -s build:mobile-frontend && npm run -s build:mobile-backend && npm run -s build:mobile-env-json",
    "build:mobile-frontend": "cross-env PUBLIC_URL=./ npm run -s build:frontend",
    "build:mobile-backend": "npm run -s build:backend && vite build --config ./mobile_backend.config.mts",
    "build:mobile-env-json": "node ./scripts/buildEnvJson.mjs",
    "build:ios-app": "cd ios/imodeljs-test-app && xcrun xcodebuild -derivedDataPath ./build/DerivedData build CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY= CODE_SIGNING_REQUIRED=NO PROVISIONING_PROFILE_SPECIFIER= -scheme imodeljs-test-app -arch arm64 -sdk iphonesimulator -configuration Debug",
    "ios": "node ./scripts/runIosSimulator.mjs",
    "ios:all": "npm run build:mobile && npm run build:ios-app && npm run ios",
    "build:android-app": "cd android/imodeljs-test-app && ./gradlew --no-daemon build",
    "android": "./scripts/runAndroidEmulator.py",
    "android:all": "npm run build:mobile && npm run android"
  },
  "repository": {},
  "dependencies": {
    "@bentley/icons-generic-webfont": "^1.0.34",
    "@cesium/core": "0.1.0",
    "@cesium/engine": "26.4.0",
    "@itwin/appui-abstract": "workspace:*",
    "@itwin/browser-authorization": "catalog:auth-clients",
    "@itwin/core-backend": "workspace:*",
    "@itwin/core-bentley": "workspace:*",
    "@itwin/core-common": "workspace:*",
    "@itwin/core-electron": "workspace:*",
    "@itwin/core-frontend": "workspace:*",
    "@itwin/ecschema-metadata": "workspace:*",
    "@itwin/ecschema-rpcinterface-common": "workspace:*",
    "@itwin/ecschema-rpcinterface-impl": "workspace:*",
    "@itwin/core-geometry": "workspace:*",
    "@itwin/core-i18n": "workspace:*",
    "@itwin/core-markup": "workspace:*",
    "@itwin/core-mobile": "workspace:*",
    "@itwin/core-quantity": "workspace:*",
    "@itwin/editor-backend": "workspace:*",
    "@itwin/editor-common": "workspace:*",
    "@itwin/editor-frontend": "workspace:*",
    "@itwin/electron-authorization": "catalog:auth-clients",
    "@itwin/frontend-devtools": "workspace:*",
    "@itwin/frontend-tiles": "workspace:*",
    "@itwin/hypermodeling-frontend": "workspace:*",
    "@itwin/imodels-access-backend": "catalog:imodels-clients",
    "@itwin/imodels-access-frontend": "catalog:imodels-clients",
    "@itwin/imodels-client-authoring": "catalog:imodels-clients",
    "@itwin/imodels-client-management": "catalog:imodels-clients",
    "@itwin/map-layers-formats": "workspace:*",
    "@itwin/object-storage-azure": "catalog:imodels-clients",
    "@itwin/reality-data-client": "catalog:reality-capture",
    "@itwin/webgl-compatibility": "workspace:*",
    "@itwin/cesium-renderer": "workspace:*",
    "vhacd-js": "^0.0.1"
  },
  "devDependencies": {
    "@itwin/build-tools": "workspace:*",
    "@itwin/eslint-plugin": "catalog:linting",
    "@types/express": "catalog:types",
    "@types/express-ws": "catalog:types",
    "@types/node": "catalog:build",
    "@typescript-eslint/parser": "catalog:linting",
    "browserslist-to-esbuild": "catalog:bundling",
    "child_process": "^1.0.2",
    "cross-env": "catalog:build",
    "dotenv": "catalog:testing",
    "dotenv-expand": "catalog:testing",
    "electron": "^45.0.0",
    "eslint": "catalog:linting",
    "express": "^4.22.1",
    "express-ws": "^5.0.2",
    "internal-tools": "workspace:*",
    "node-simctl": "catalog:testing",
    "npm-run-all2": "catalog:build",
    "react": "^18.0.0",
    "rimraf": "catalog:build",
    "rollup-plugin-ignore": "catalog:bundling",
    "rollup-plugin-visualizer": "catalog:bundling",
    "rollup-plugin-webpack-stats": "catalog:bundling",
    "rollup-plugin-external-globals": "catalog:bundling",
    "typescript": "catalog:build",
    "vite": "catalog:bundling",
    "vite-plugin-env-compatible": "catalog:bundling"
  },
  "browserslist": [
    "last 4 chrome version",
    "last 4 firefox version",
    "last 4 safari version",
    "last 4 ios version",
    "last 4 ChromeAndroid version",
    "last 4 edge version",
    "not dead",
    "not <0.2%"
  ]
}
