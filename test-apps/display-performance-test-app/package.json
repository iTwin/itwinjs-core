{
  "name": "display-performance-test-app",
  "description": "Display performance test application.",
  "license": "UNLICENSED",
  "author": {
    "name": "Bentley Systems, Inc.",
    "url": "http://www.bentley.com"
  },
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "npm run -s build:frontend && npm run -s build:backend",
    "build:stats": "cross-env OUTPUT_STATS=TRUE npm run build",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build:frontend": "tsc && cross-env NODE_OPTIONS=--max_old_space_size=8192 vite build",
    "clean": "rimraf -g .static-assets lib .rush/temp/package-deps*.json",
    "docs": "",
    "lint": "eslint \"./src/**/*.ts\" 1>&2",
    "lint-deprecation": "",
    "start": "cross-env NODE_ENV=development run-p start:webserver start:electron",
    "start:webserver": "vite",
    "start:electron": "electron ./lib/backend/ElectronMain.js",
    "start:web": "node lib/backend/WebMain.js",
    "test:electron": "electron ./lib/backend/ElectronMain.js",
    "test:chrome": "node ./lib/common/npmCommands.js chrome",
    "test:edge": "node ./lib/common/npmCommands.js edge",
    "test:firefox": "node ./lib/common/npmCommands.js firefox",
    "test:safari": "node ./lib/common/npmCommands.js safari",
    "copy:config": "internal-tools copy-config",
    "test": "",
    "cover": ""
  },
  "repository": {},
  "dependencies": {
    "@itwin/appui-abstract": "workspace:*",
    "@itwin/browser-authorization": "^1.0.1",
    "@itwin/core-backend": "workspace:*",
    "@itwin/core-bentley": "workspace:*",
    "@itwin/core-common": "workspace:*",
    "@itwin/core-electron": "workspace:*",
    "@itwin/core-frontend": "workspace:*",
    "@itwin/core-geometry": "workspace:*",
    "@itwin/core-quantity": "workspace:*",
    "@itwin/electron-authorization": "^0.24.0",
    "@itwin/hypermodeling-frontend": "workspace:*",
    "@itwin/frontend-tiles": "workspace:*",
    "@itwin/imodels-access-backend": "^6.0.2",
    "@itwin/imodels-access-frontend": "^6.0.2",
    "@itwin/imodels-client-authoring": "^6.0.2",
    "@itwin/imodels-client-management": "^6.0.2",
    "@itwin/reality-data-client": "^1.3.1",
    "@itwin/object-storage-azure": "^3.0.4",
    "@itwin/oidc-signin-tool": "^5.0.2"
  },
  "devDependencies": {
    "@itwin/perf-tools": "workspace:*",
    "@itwin/build-tools": "workspace:*",
    "@itwin/eslint-plugin": "catalog:linting",
    "browserslist-to-esbuild": "catalog:bundling",
    "@types/express": "catalog:types",
    "@types/node": "catalog:build",
    "@typescript-eslint/parser": "catalog:linting",
    "child_process": "^1.0.2",
    "chrome-launcher": "^0.15.2",
    "cross-env": "catalog:build",
    "dotenv": "^16.4.5",
    "dotenv-expand": "^5.1.0",
    "electron": "^45.0.0",
    "eslint": "catalog:linting",
    "express": "^4.22.1",
    "internal-tools": "workspace:*",
    "npm-run-all2": "catalog:build",
    "react": "^18.0.0",
    "rimraf": "catalog:build",
    "rollup-plugin-ignore": "catalog:bundling",
    "rollup-plugin-visualizer": "catalog:bundling",
    "rollup-plugin-webpack-stats": "catalog:bundling",
    "rollup-plugin-external-globals": "catalog:bundling",
    "typescript": "catalog:build",
    "vite": "catalog:bundling",
    "vite-plugin-env-compatible": "catalog:bundling"
  },
  "homepage": "http://localhost:3000/",
  "browserslist": [
    "last 4 chrome version",
    "last 4 firefox version",
    "last 4 safari version",
    "last 4 ios version",
    "last 4 ChromeAndroid version",
    "last 4 edge version",
    "not dead",
    "not <0.2%"
  ]
}
