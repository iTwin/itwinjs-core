{
  "extends": "./node_modules/@itwin/build-tools/tsconfig-base.json",
  "compilerOptions": {
    "outDir": "./lib",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolvePackageJsonExports": true,
    "types": ["vitest/globals", "node"],
    "baseUrl": ".",
    "paths": {
      "@itwin/core-frontend/lib/cjs/internal/test-support": ["../../core/frontend/lib/cjs/internal/test-support.d.ts"],
      "@itwin/vitest-browser-bridge/callbacks/backend": ["../../tools/vitest-browser-bridge/lib/cjs/callbacks/backend.d.ts"],
      "@itwin/vitest-browser-bridge/callbacks/http": ["../../tools/vitest-browser-bridge/lib/cjs/callbacks/http.d.ts"],
      "@itwin/vitest-browser-bridge/callbacks/browser": ["../../tools/vitest-browser-bridge/lib/esm/callbacks/browser.d.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.mts"
  ]
}