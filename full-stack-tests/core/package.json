{
  "name": "core-full-stack-tests",
  "//private": "NOTE: this is a private package that is never published",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "copy:config": "internal-tools copy-config",
    "build": "tsc 1>&2",
    "clean": "rimraf -g lib .rush/temp/package-deps*.json coverage",
    "cover": "npm run -s test",
    "docs": "",
    "lint": "eslint \"./src/**/*.ts\" 1>&2",
    "lint-fix": "eslint --fix -f visualstudio \"./src/**/*.ts\" 1>&2",
    "lint-deprecation": "",
    "azurite:setup": "mkdirp ./lib/cjs/test/azuriteStorage && azurite-blob --skipApiVersionCheck --silent --loose --location ./lib/cjs/test/azuriteStorage",
    "test": "npm run -s test:unit && cross-env DEBUG_LEAKS=true npm run -s test:chrome && npm run -s test:electron",
    "test:unit": "vitest run --config src/test/vitest.config.mts",
    "test:chrome": "run-p -r azurite:setup test:chrome:vitest",
    "test:chrome:vitest": "vitest run --config vitest.browser.config.mts",
    "test:electron": "run-p -r azurite:setup test:electron:vitest",
    "test:electron:vitest": "vitest run --config vitest.electron.config.mts",
    "debug:chrome": "run-p -r azurite:setup \"test:chrome:vitest -- --inspect-brk\"",
    "debug:electron": "cross-env VITEST_CORE_DEBUG=1 run-p -r azurite:setup test:electron:vitest",
    "test:integration": "npm run -s test:integration:chrome && npm run -s test:integration:electron",
    "test:integration:chrome": "cross-env VITEST_CORE_GREP=\"#integration\" VITEST_CORE_GREP_INVERT=false vitest run --config vitest.browser.config.mts",
    "test:integration:chrome:no-graphics": "cross-env VITEST_CORE_GREP=\"^(?!.*#graphics).*#integration\" VITEST_CORE_GREP_INVERT=false vitest run --config vitest.browser.config.mts",
    "test:integration:electron": "cross-env VITEST_CORE_GREP=\"#integration\" VITEST_CORE_GREP_INVERT=false vitest run --config vitest.electron.config.mts",
    "test:integration:no-graphics": "npm run -s test:integration:chrome:no-graphics && npm run -s test:integration:electron:no-graphics",
    "test:integration:electron:no-graphics": "cross-env VITEST_CORE_GREP=\"^(?!.*#graphics).*#integration\" VITEST_CORE_GREP_INVERT=false vitest run --config vitest.electron.config.mts",
    "test:integration:graphics": "npm run -s test:integration:chrome:graphics && npm run -s test:integration:electron:graphics",
    "test:integration:chrome:graphics": "cross-env VITEST_CORE_GREP=\"#graphics\" VITEST_CORE_GREP_INVERT=false VITEST_CORE_JUNIT_FILE=lib/test/junit_results_graphics_chrome.xml vitest run --config vitest.browser.config.mts",
    "test:integration:electron:graphics": "cross-env VITEST_CORE_GREP=\"#graphics\" VITEST_CORE_GREP_INVERT=false VITEST_CORE_JUNIT_FILE=lib/test/junit_results_graphics_electron.xml vitest run --config vitest.electron.config.mts",
    "test:performance": "npm run -s test:performance:chrome && npm run -s test:performance:electron",
    "test:performance:chrome": "run-p -r azurite:setup test:performance:chrome:vitest",
    "test:performance:chrome:vitest": "cross-env VITEST_CORE_GREP=\"#performance\" VITEST_CORE_GREP_INVERT=false vitest run --config vitest.browser.config.mts",
    "test:performance:electron": "run-p -r azurite:setup test:performance:electron:vitest",
    "test:performance:electron:vitest": "cross-env VITEST_CORE_GREP=\"#performance\" VITEST_CORE_GREP_INVERT=false vitest run --config vitest.electron.config.mts"
  },
  "repository": {},
  "dependencies": {
    "@azure/storage-blob": "catalog:runtime",
    "@itwin/core-backend": "workspace:*",
    "@itwin/core-bentley": "workspace:*",
    "@itwin/core-common": "workspace:*",
    "@itwin/core-electron": "workspace:*",
    "@itwin/core-frontend": "workspace:*",
    "@itwin/core-geometry": "workspace:*",
    "@itwin/core-markup": "workspace:*",
    "@itwin/core-quantity": "workspace:*",
    "@itwin/ecschema-metadata": "workspace:*",
    "@itwin/ecschema-rpcinterface-common": "workspace:*",
    "@itwin/ecschema-rpcinterface-impl": "workspace:*",
    "@itwin/ecsql-common": "workspace:*",
    "@itwin/editor-backend": "workspace:*",
    "@itwin/editor-common": "workspace:*",
    "@itwin/editor-frontend": "workspace:*",
    "@itwin/electron-authorization": "catalog:auth-clients",
    "@itwin/express-server": "workspace:*",
    "@itwin/hypermodeling-frontend": "workspace:*",
    "@itwin/imodels-access-backend": "catalog:imodels-clients",
    "@itwin/imodels-access-frontend": "catalog:imodels-clients",
    "@itwin/imodels-client-authoring": "catalog:imodels-clients",
    "@itwin/imodels-client-management": "catalog:imodels-clients",
    "@itwin/object-storage-azure": "catalog:imodels-clients",
    "@itwin/reality-data-client": "catalog:reality-capture",
    "azurite": "catalog:testing",
    "electron": "catalog:electron",
    "fs-extra": "catalog:utilities"
  },
  "devDependencies": {
    "@itwin/build-tools": "workspace:*",
    "@itwin/eslint-plugin": "catalog:linting",
    "@itwin/itwins-client": "catalog:itwins-client",
    "@itwin/object-storage-core": "catalog:imodels-clients",
    "@itwin/oidc-signin-tool": "catalog:auth-clients",
    "@itwin/vitest-browser-bridge": "workspace:*",
    "@itwin/service-authorization": "catalog:auth-clients",
    "@types/fs-extra": "catalog:utilities",
    "@types/node": "catalog:build",
    "@vitest/browser": "catalog:testing",
    "@vitest/browser-playwright": "catalog:testing",
    "cross-env": "catalog:build",
    "dotenv": "catalog:testing",
    "dotenv-expand": "catalog:testing",
    "eslint": "catalog:linting",
    "internal-tools": "workspace:*",
    "mkdirp": "catalog:build",
    "nock": "^12.0.3",
    "npm-run-all2": "catalog:build",
    "path-browserify": "catalog:bundling",
    "playwright": "catalog:testing",
    "rimraf": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:testing"
  }
}
