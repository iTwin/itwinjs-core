{
  "name": "core-full-stack-tests",
  "//private": "NOTE: this is a private package that is never published",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "copy:config": "internal-tools copy-config",
    "build": "tsc 1>&2 && npm run -s webpack:test",
    "clean": "rimraf -g lib .rush/temp/package-deps*.json coverage",
    "cover": "npm run -s test",
    "docs": "",
    "lint": "eslint \"./src/**/*.ts\" 1>&2",
    "lint-fix": "eslint --fix -f visualstudio \"./src/**/*.ts\" 1>&2",
    "lint-deprecation": "",
    "azurite:setup": "mkdirp ./lib/cjs/test/azuriteStorage && azurite-blob --skipApiVersionCheck --silent --loose --location ./lib/cjs/test/azuriteStorage",
    "test": "cross-env DEBUG_LEAKS=true npm run -s test:chrome && npm run -s test:electron",
    "test:chrome": "run-p -r azurite:setup test:chrome:azurite",
    "test:electron": "run-p -r azurite:setup test:electron:azurite",
    "debug:chrome": "run-p -r azurite:setup \"test:chrome:azurite -- --debug\"",
    "debug:electron": "run-p -r azurite:setup \"test:electron:azurite -- --debug\"",
    "test:chrome:azurite": "certa -r chrome --grep \"#integration|#performance\" --invert",
    "test:electron:azurite": "certa -r electron --grep \"#integration|#performance\" --invert",
    "test:integration": "npm run -s test:integration:chrome && npm run -s test:integration:electron",
    "test:integration:chrome": "cross-env MOCHA_FILE=lib/test/junit_results_chrome.xml certa -r chrome --grep \"#integration\"",
    "test:integration:chrome:no-graphics": "cross-env MOCHA_FILE=lib/test/junit_results_chrome.xml certa -r chrome --grep \"^(?!.*#graphics).*#integration\"",
    "test:integration:electron": "cross-env MOCHA_FILE=lib/test/junit_results_electron.xml certa -r electron --grep \"#integration\"",
    "test:integration:no-graphics": "npm run -s test:integration:chrome:no-graphics && npm run -s test:integration:electron:no-graphics",
    "test:integration:electron:no-graphics": "cross-env MOCHA_FILE=lib/test/junit_results_electron.xml certa -r electron --grep \"^(?!.*#graphics).*#integration\"",
    "test:integration:graphics": "npm run -s test:integration:chrome:graphics && npm run -s test:integration:electron:graphics",
    "test:integration:chrome:graphics": "cross-env MOCHA_FILE=lib/test/junit_results_graphics_chrome.xml certa -r chrome --grep \"#graphics\"",
    "test:integration:electron:graphics": "cross-env MOCHA_FILE=lib/test/junit_results_graphics_electron.xml certa -r electron --grep \"#graphics\"",
    "test:performance": "npm run -s test:performance:chrome && npm run -s test:performance:electron",
    "test:performance:chrome": "run-p -r azurite:setup test:performance:chrome:azurite",
    "test:performance:electron": "run-p -r azurite:setup test:performance:electron:azurite",
    "test:performance:chrome:azurite": "certa -r chrome --grep \"#performance\"",
    "test:performance:electron:azurite": "certa -r electron --grep \"#performance\"",
    "webpack:test": "webpack --config webpack.config.js 1>&2"
  },
  "repository": {},
  "dependencies": {
    "@azure/storage-blob": "^12.28.0",
    "@itwin/core-backend": "workspace:*",
    "@itwin/core-bentley": "workspace:*",
    "@itwin/core-common": "workspace:*",
    "@itwin/core-electron": "workspace:*",
    "@itwin/core-frontend": "workspace:*",
    "@itwin/core-geometry": "workspace:*",
    "@itwin/core-markup": "workspace:*",
    "@itwin/core-quantity": "workspace:*",
    "@itwin/ecschema-metadata": "workspace:*",
    "@itwin/ecschema-rpcinterface-common": "workspace:*",
    "@itwin/ecschema-rpcinterface-impl": "workspace:*",
    "@itwin/ecsql-common": "workspace:*",
    "@itwin/editor-backend": "workspace:*",
    "@itwin/editor-common": "workspace:*",
    "@itwin/editor-frontend": "workspace:*",
    "@itwin/electron-authorization": "catalog:auth-clients",
    "@itwin/express-server": "workspace:*",
    "@itwin/hypermodeling-frontend": "workspace:*",
    "@itwin/imodels-access-backend": "catalog:imodels-clients",
    "@itwin/imodels-access-frontend": "catalog:imodels-clients",
    "@itwin/imodels-client-authoring": "catalog:imodels-clients",
    "@itwin/imodels-client-management": "catalog:imodels-clients",
    "@itwin/object-storage-azure": "catalog:imodels-clients",
    "@itwin/reality-data-client": "catalog:reality-capture",
    "azurite": "catalog:testing",
    "chai-as-promised": "catalog:testing",
    "chai": "catalog:testing",
    "electron": "catalog:electron",
    "fs-extra": "^8.1.0",
    "sinon-chai": "catalog:testing",
    "sinon": "catalog:testing"
  },
  "devDependencies": {
    "@itwin/build-tools": "workspace:*",
    "@itwin/certa": "workspace:*",
    "@itwin/eslint-plugin": "catalog:linting",
    "@itwin/itwins-client": "catalog:itwins-client",
    "@itwin/object-storage-core": "catalog:imodels-clients",
    "@itwin/oidc-signin-tool": "catalog:auth-clients",
    "@types/chai": "catalog:testing",
    "@types/chai-as-promised": "catalog:testing",
    "@types/fs-extra": "catalog:types",
    "@types/mocha": "catalog:testing",
    "@types/node": "catalog:build",
    "@types/sinon": "catalog:testing",
    "@types/sinon-chai": "catalog:testing",
    "assert": "catalog:bundling",
    "babel-loader": "catalog:bundling",
    "babel-plugin-istanbul": "catalog:testing",
    "browserify-zlib": "catalog:bundling",
    "cross-env": "catalog:build",
    "dotenv": "catalog:testing",
    "dotenv-expand": "catalog:testing",
    "eslint": "catalog:linting",
    "glob": "catalog:build",
    "https-browserify": "^1.0.0",
    "internal-tools": "workspace:*",
    "mkdirp": "catalog:build",
    "nock": "^12.0.3",
    "npm-run-all2": "catalog:build",
    "null-loader": "catalog:bundling",
    "path-browserify": "catalog:bundling",
    "rimraf": "catalog:build",
    "source-map-loader": "catalog:bundling",
    "stream-browserify": "catalog:bundling",
    "stream-http": "^3.2.0",
    "typescript": "catalog:build",
    "webpack": "catalog:bundling",
    "webpack-cli": "catalog:bundling"
  },
  "nyc": {
    "extends": "./node_modules/@itwin/build-tools/.nycrc"
  }
}
