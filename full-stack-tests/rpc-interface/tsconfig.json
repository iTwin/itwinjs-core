{
  "extends": "./node_modules/@itwin/build-tools/tsconfig-base.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./lib",
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.mts",
    "src/**/*.json"
  ]
}
