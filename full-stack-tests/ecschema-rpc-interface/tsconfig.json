{
  "extends": "./node_modules/@itwin/build-tools/tsconfig-base.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "outDir": "./lib",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.mts",
    "src/**/*.json"
  ],
  "exclude": [
    "./lib",
    "node_modules"
  ]
}