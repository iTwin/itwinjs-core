{
  "name": "rpc-full-stack-tests",
  "//private": "NOTE: this is a private package that is never published",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc 1>&2",
    "clean": "rimraf -g lib .rush/temp/package-deps*.json coverage",
    "cover": "npm -s test",
    "docs": "",
    "lint": "eslint \"./src/**/*.ts\" 1>&2",
    "lint-deprecation": "",
    "test": "npm run -s test:unit && npm run -s test:chrome && npm run -s test:electron && npm run -s test:chrome-websocket",
    "test:unit": "vitest run --config vitest.node.config.mts",
    "test:chrome": "cross-env VITEST_RPC_ENVIRONMENT=http vitest run --config vitest.browser.config.mts",
    "test:chrome-websocket": "cross-env VITEST_RPC_ENVIRONMENT=websocket vitest run --config vitest.browser.config.mts",
    "test:electron": "vitest run --config vitest.electron.config.mts"
  },
  "repository": {},
  "dependencies": {
    "@itwin/core-backend": "workspace:*",
    "@itwin/core-bentley": "workspace:*",
    "@itwin/core-common": "workspace:*",
    "@itwin/core-electron": "workspace:*",
    "@itwin/core-frontend": "workspace:*",
    "@itwin/core-mobile": "workspace:*",
    "@itwin/express-server": "workspace:*",
    "electron": "catalog:electron",
    "semver": "catalog:utilities"
  },
  "devDependencies": {
    "@itwin/build-tools": "workspace:*",
    "@itwin/eslint-plugin": "catalog:linting",
    "@itwin/vitest-browser-bridge": "workspace:*",
    "@types/chai": "catalog:testing",
    "@types/express": "catalog:runtime",
    "@types/node": "catalog:build",
    "@types/semver": "catalog:utilities",
    "@vitest/browser": "catalog:testing",
    "@vitest/browser-playwright": "catalog:testing",
    "assert": "catalog:bundling",
    "buffer": "catalog:bundling",
    "chai": "catalog:testing",
    "cross-env": "catalog:build",
    "eslint": "catalog:linting",
    "playwright": "catalog:testing",
    "rimraf": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:testing"
  }
}
