{
  "name": "rpc-full-stack-tests",
  "//private": "NOTE: this is a private package that is never published",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc 1>&2",
    "clean": "rimraf -g lib .rush/temp/package-deps*.json coverage",
    "cover": "npm -s test",
    "docs": "",
    "lint": "eslint \"./src/**/*.ts\" 1>&2",
    "lint-deprecation": "",
    "test": "npm run -s test:chrome && npm run -s test:electron && npm run -s test:chrome-websocket",
    "test:chrome": "cross-env VITEST_RPC_ENVIRONMENT=http vitest run --config vitest.browser.config.mts",
    "test:chrome-websocket": "cross-env VITEST_RPC_ENVIRONMENT=websocket vitest run --config vitest.browser.config.mts",
    "test:electron": "vitest run --config vitest.electron.config.mts"
  },
  "repository": {},
  "dependencies": {
    "@itwin/core-backend": "workspace:*",
    "@itwin/core-bentley": "workspace:*",
    "@itwin/core-common": "workspace:*",
    "@itwin/core-electron": "workspace:*",
    "@itwin/core-frontend": "workspace:*",
    "@itwin/core-mobile": "workspace:*",
    "@itwin/express-server": "workspace:*",
    "electron": "^44.0.0",
    "express": "^4.22.1",
    "semver": "^7.5.2",
    "spdy": "^4.0.1"
  },
  "devDependencies": {
    "@itwin/build-tools": "workspace:*",
    "@itwin/eslint-plugin": "^6.0.0",
    "@types/chai": "4.3.1",
    "@itwin/vitest-browser-bridge": "workspace:*",
    "@types/express": "^4.17.20",
    "@types/node": "~20.17.0",
    "@types/semver": "7.3.10",
    "@types/spdy": "^3.4.4",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.10",
    "assert": "^2.0.0",
    "buffer": "^6.0.3",
    "chai": "^4.3.10",
    "cross-env": "^7.0.3",
    "eslint": "^9.31.0",
    "playwright": "~1.56.1",
    "rimraf": "^6.0.1",
    "typescript": "~5.6.2",
    "vitest": "^4.1.11"
  }
}
