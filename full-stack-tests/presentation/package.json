{
  "name": "presentation-full-stack-tests",
  "version": "0.0.0",
  "private": true,
  "description": "Presentation integration tests",
  "license": "UNLICENSED",
  "author": {
    "name": "Bentley Systems, Inc.",
    "url": "http://www.bentley.com"
  },
  "type": "module",
  "scripts": {
    "build": "node ./scripts/setup-tests.cjs && tsc",
    "build:watch": "npm run build -- -w",
    "clean": "rimraf -g lib out .rush/temp/package-deps*.json",
    "docs": "npm run -s extract",
    "extract": "betools extract --fileExt=ts,tsx --extractFrom=./src --recursive --out=../../generated-docs/extract",
    "lint": "eslint \"./src/**/*.ts\" 1>&2",
    "lint-deprecation": "",
    "test": "cross-env NODE_ENV=development mocha --enable-source-maps --config ./.mocharc.json --grep \"#performance\" --invert",
    "test:performance": "mocha --config ./.mocharc.json --grep \"#performance\" --no-timeouts",
    "copy:config": "internal-tools copy-config",
    "cover": "npm run -s test",
    "prettier:fix": "prettier --write ."
  },
  "dependencies": {
    "@itwin/build-tools": "workspace:*",
    "@itwin/core-backend": "workspace:*",
    "@itwin/core-bentley": "workspace:*",
    "@itwin/core-common": "workspace:*",
    "@itwin/core-frontend": "workspace:*",
    "@itwin/core-geometry": "workspace:*",
    "@itwin/core-i18n": "workspace:*",
    "@itwin/core-quantity": "workspace:*",
    "@itwin/ecschema-metadata": "workspace:*",
    "@itwin/ecschema-rpcinterface-common": "workspace:*",
    "@itwin/ecschema-rpcinterface-impl": "workspace:*",
    "@itwin/eslint-plugin": "catalog:linting",
    "@itwin/presentation-backend": "workspace:*",
    "@itwin/presentation-common": "workspace:*",
    "@itwin/presentation-frontend": "workspace:*",
    "@itwin/presentation-shared": "catalog:presentation",
    "@itwin/unified-selection": "catalog:presentation",
    "@types/chai": "catalog:testing",
    "@types/chai-as-promised": "catalog:testing",
    "@types/chai-jest-snapshot": "catalog:testing",
    "@types/chai-subset": "catalog:testing",
    "@types/cpx2": "npm:@types/cpx@1.5.2",
    "@types/deep-equal": "catalog:testing",
    "@types/jsdom": "catalog:testing",
    "@types/mocha": "catalog:testing",
    "@types/node": "catalog:build",
    "@types/sinon": "catalog:testing",
    "@types/sinon-chai": "catalog:testing",
    "chai": "catalog:testing",
    "chai-as-promised": "catalog:testing",
    "chai-jest-snapshot": "catalog:testing",
    "chai-subset": "catalog:testing",
    "cpx2": "catalog:build",
    "cross-env": "catalog:build",
    "deep-equal": "catalog:testing",
    "dotenv": "^16.4.5",
    "dotenv-expand": "^5.1.0",
    "eslint": "catalog:linting",
    "eslint-config-prettier": "catalog:linting",
    "fast-sort": "^3.0.2",
    "fast-xml-parser": "^5.5.6",
    "global-jsdom": "^26.0.0",
    "i18next-http-backend": "^4.0.5",
    "internal-tools": "workspace:*",
    "jsdom": "catalog:testing",
    "mocha": "^11.1.0",
    "prettier": "catalog:linting",
    "rimraf": "catalog:build",
    "sanitize-filename": "^1.6.3",
    "sinon": "catalog:testing",
    "sinon-chai": "catalog:testing",
    "typescript": "catalog:build"
  }
}
