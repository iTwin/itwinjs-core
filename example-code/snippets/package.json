{
  "name": "example-code-snippets",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "azurite:setup": "mkdirp ./lib/cjs/test/azuriteStorage && azurite-blob --skipApiVersionCheck --blobPort 10001 --silent --loose --location ./lib/test/azuriteStorage",
    "build": "tsc 1>&2",
    "clean": "rimraf -g lib .rush/temp/package-deps*.json ../../generated-docs",
    "copy:assets": "cpx \"./src/backend/assets/**/*\" ./lib/backend/assets",
    "extract": "betools extract --fileExt=ts --extractFrom=./src --recursive --out=../../generated-docs/extract",
    "docs": "npm run -s copy:assets && npm run -s extract",
    "lint": "eslint \"./src/**/*.ts\" 1>&2",
    "lint-fix": "eslint --fix -f visualstudio \"./src/**/*.ts\" 1>&2",
    "lint-deprecation": "",
    "test": "npm run -s test:azurite",
    "test:backend": "npm run -s copy:assets &&  mocha --no-config",
    "test:azurite": "run-p -r azurite:setup test:backend",
    "cover": "npm -s test"
  },
  "repository": {},
  "dependencies": {
    "@azure/storage-blob": "^12.28.0",
    "@itwin/core-backend": "workspace:*",
    "@itwin/core-bentley": "workspace:*",
    "@itwin/core-common": "workspace:*",
    "@itwin/core-extension": "workspace:*",
    "@itwin/core-frontend": "workspace:*",
    "@itwin/core-geometry": "workspace:*",
    "@itwin/core-quantity": "workspace:*",
    "@itwin/ecschema-editing": "workspace:*",
    "@itwin/ecschema-locaters": "workspace:*",
    "@itwin/ecschema-metadata": "workspace:*",
    "@itwin/imodel-transformer": "^0.4.2",
    "@itwin/itwins-client": "^1.6.1",
    "@itwin/map-layers-formats": "workspace:*",
    "@xmldom/xmldom": "~0.8.15",
    "azurite": "catalog:testing",
    "fs-extra": "^8.1.0",
    "get-system-fonts": "^2.0.2"
  },
  "devDependencies": {
    "@itwin/build-tools": "workspace:*",
    "@itwin/eslint-plugin": "catalog:linting",
    "@itwin/oidc-signin-tool": "^5.0.2",
    "@types/chai": "catalog:testing",
    "@types/fs-extra": "catalog:types",
    "@types/jsdom": "catalog:testing",
    "@types/mocha": "catalog:testing",
    "@types/node": "catalog:build",
    "chai": "catalog:testing",
    "cpx2": "catalog:build",
    "eslint": "catalog:linting",
    "jsdom": "catalog:testing",
    "mkdirp": "catalog:build",
    "mocha": "^11.1.0",
    "npm-run-all2": "catalog:build",
    "rimraf": "catalog:build",
    "typescript": "catalog:build"
  },
  "mocha": {
    "exit": true,
    "colors": true,
    "check-leaks": true,
    "spec": [
      "lib/**/*.test.js"
    ],
    "require": [
      "lib/setup.js",
      "source-map-support/register"
    ],
    "reporter": "node_modules/@itwin/build-tools/mocha-reporter",
    "reporter-options": "mochaFile=lib/test/junit_results.xml",
    "timeout": 999999
  }
}
