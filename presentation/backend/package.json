{
  "name": "@itwin/presentation-backend",
  "version": "5.16.0-dev.12",
  "description": "Backend of iTwin.js Presentation library",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iTwin/itwinjs-core.git",
    "directory": "presentation/backend"
  },
  "keywords": [
    "Bentley",
    "EC",
    "Presentation",
    "iTwin",
    "iTwin.js",
    "Backend"
  ],
  "author": {
    "name": "Bentley Systems, Inc.",
    "url": "http://www.bentley.com"
  },
  "type": "module",
  "main": "lib/cjs/presentation-backend.js",
  "types": "lib/cjs/presentation-backend",
  "module": "lib/esm/presentation-backend.js",
  "exports": {
    ".": {
      "import": "./lib/esm/presentation-backend.js",
      "require": "./lib/cjs/presentation-backend.js"
    },
    "./internal": {
      "import": "./lib/esm/presentation-backend-internal.js",
      "require": "./lib/cjs/presentation-backend-internal.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run -s build:cjs && npm run -s build:esm",
    "build:cjs": "internal-tools build-cjs",
    "build:esm": "tsc 1>&2 -p tsconfig.esm.json",
    "clean": "rimraf -g lib .rush/temp/package-deps*.json",
    "cover": "c8 npm -s test",
    "docs": "npm run -s docs:reference && npm run -s extract && npm run -s docs:changelog",
    "docs:changelog": "cpx ./CHANGELOG.md ../../generated-docs/presentation/presentation-backend",
    "docs:reference": "betools docs --json=../../generated-docs/presentation/presentation-backend/file.json --tsIndexFile=presentation-backend.ts --tsconfig=tsconfig.esm.json --onlyJson",
    "extract": "betools extract --fileExt=ts --extractFrom=./src/test --recursive --out=../../generated-docs/extract",
    "extract-api": "betools extract-api --entry=lib/esm/presentation-backend",
    "lint": "eslint \"./src/**/*.ts\" 1>&2",
    "lint-deprecation": "eslint --fix -f visualstudio --no-inline-config -c ../../common/config/eslint/eslint.config.deprecation-policy.js \"./src/**/*.ts\"",
    "test": "mocha --enable-source-maps  --config ./.mocharc.json",
    "prettier:fix": "prettier --write ."
  },
  "peerDependencies": {
    "@itwin/core-backend": "workspace:*",
    "@itwin/core-bentley": "workspace:*",
    "@itwin/core-common": "workspace:*",
    "@itwin/core-quantity": "workspace:*",
    "@itwin/ecschema-metadata": "workspace:*",
    "@itwin/presentation-common": "workspace:*"
  },
  "devDependencies": {
    "@itwin/build-tools": "workspace:*",
    "@itwin/core-backend": "workspace:*",
    "@itwin/core-bentley": "workspace:*",
    "@itwin/core-common": "workspace:*",
    "@itwin/core-quantity": "workspace:*",
    "@itwin/ecschema-metadata": "workspace:*",
    "@itwin/eslint-plugin": "catalog:linting",
    "@itwin/presentation-common": "workspace:*",
    "@sinonjs/fake-timers": "^11.2.2",
    "@types/chai": "catalog:testing",
    "@types/chai-as-promised": "catalog:testing",
    "@types/chai-jest-snapshot": "catalog:testing",
    "@types/chai-subset": "catalog:testing",
    "@types/deep-equal": "catalog:testing",
    "@types/mocha": "catalog:testing",
    "@types/node": "catalog:build",
    "@types/object-hash": "^1.3.0",
    "@types/semver": "catalog:utilities",
    "@types/sinon": "catalog:testing",
    "@types/sinon-chai": "catalog:testing",
    "@types/sinonjs__fake-timers": "^8.1.5",
    "c8": "catalog:testing",
    "chai": "catalog:testing",
    "chai-as-promised": "catalog:testing",
    "chai-jest-snapshot": "catalog:testing",
    "chai-subset": "catalog:testing",
    "cpx2": "catalog:build",
    "deep-equal": "catalog:testing",
    "eslint": "catalog:linting",
    "eslint-config-prettier": "catalog:linting",
    "internal-tools": "workspace:*",
    "mocha": "catalog:testing",
    "prettier": "catalog:linting",
    "rimraf": "catalog:build",
    "sinon": "catalog:testing",
    "sinon-chai": "catalog:testing",
    "typescript": "catalog:build"
  },
  "dependencies": {
    "@itwin/presentation-shared": "catalog:presentation",
    "object-hash": "^1.3.1",
    "rxjs": "catalog:presentation",
    "rxjs-for-await": "catalog:presentation",
    "semver": "catalog:utilities"
  }
}
