{
  "name": "@itwin/appui-abstract",
  "version": "5.16.0-dev.13",
  "description": "iTwin.js UI abstractions",
  "main": "lib/cjs/appui-abstract.js",
  "module": "lib/esm/appui-abstract.js",
  "typings": "lib/cjs/appui-abstract",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iTwin/itwinjs-core.git",
    "directory": "ui/appui-abstract"
  },
  "scripts": {
    "build": "npm run -s build:cjs && npm run -s build:esm",
    "build:cjs": "tsc 1>&2 --outDir lib/cjs",
    "build:esm": "tsc 1>&2 --module ES2022 --outDir lib/esm",
    "pseudolocalize": "betools pseudolocalize --englishDir ./public/locales/en --out ./public/locales/en-PSEUDO",
    "clean": "rimraf -g lib .rush/temp/package-deps*.json",
    "cover": "npm -s test",
    "docs": "betools docs --json=../../generated-docs/ui/appui-abstract/file.json --tsIndexFile=./appui-abstract.ts --onlyJson",
    "lint": "eslint \"./src/**/*.ts\" 1>&2",
    "lint-deprecation": "eslint --fix -f visualstudio --no-inline-config -c ../../common/config/eslint/eslint.config.deprecation-policy.js \"./src/**/*.ts\"",
    "extract-api": "betools extract-api --entry=appui-abstract",
    "test": "npm run -s webpackTests && certa -r chrome",
    "test:watch": "npm -s test -- --reporter min --watch-extensions ts --watch",
    "webpackTests": "webpack --config ./src/test/utils/webpack.config.js 1>&2"
  },
  "keywords": [
    "Bentley",
    "BIM",
    "iModel",
    "iTwin.js"
  ],
  "author": {
    "name": "Bentley Systems, Inc.",
    "url": "http://www.bentley.com"
  },
  "peerDependencies": {
    "@itwin/core-bentley": "workspace:*"
  },
  "//devDependencies": [
    "NOTE: All peerDependencies should also be listed as devDependencies since peerDependencies are not considered by npm install",
    "NOTE: All tools used by scripts in this package must be listed as devDependencies"
  ],
  "devDependencies": {
    "@itwin/build-tools": "workspace:*",
    "@itwin/core-bentley": "workspace:*",
    "@itwin/eslint-plugin": "catalog:linting",
    "@itwin/certa": "workspace:*",
    "@types/chai": "catalog:testing",
    "@types/mocha": "catalog:testing",
    "@types/sinon": "catalog:testing",
    "babel-loader": "catalog:bundling",
    "babel-plugin-istanbul": "catalog:testing",
    "chai": "catalog:testing",
    "eslint": "catalog:linting",
    "glob": "catalog:build",
    "mocha": "catalog:testing",
    "rimraf": "catalog:build",
    "sinon": "catalog:testing",
    "source-map-loader": "catalog:bundling",
    "typescript": "catalog:build",
    "webpack": "catalog:bundling"
  },
  "//dependencies": [
    "NOTE: these dependencies should be only for things that DO NOT APPEAR IN THE API",
    "NOTE: core-frontend should remain UI technology agnostic, so no react/angular dependencies are allowed"
  ]
}
