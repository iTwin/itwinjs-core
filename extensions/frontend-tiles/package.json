{
  "name": "@itwin/frontend-tiles",
  "version": "5.16.0-dev.7",
  "description": "Experimental alternative technique for visualizing the contents of iModels",
  "main": "lib/cjs/frontend-tiles.js",
  "module": "lib/esm/frontend-tiles.js",
  "typings": "lib/cjs/frontend-tiles",
  "type": "module",
  "exports": {
    ".": {
      "import": "./lib/esm/frontend-tiles.js",
      "require": "./lib/cjs/frontend-tiles.js"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "npm run -s build:cjs && npm run -s build:esm",
    "build:cjs": "internal-tools build-cjs",
    "build:esm": "tsc 1>&2 --outDir lib/esm",
    "clean": "rimraf -g lib .rush/temp/package-deps*.json",
    "cover": "npm -s test",
    "docs": "",
    "extract-api": "betools extract-api --entry=frontend-tiles",
    "lint": "eslint \"./src/**/*.ts\" 1>&2",
    "lint-fix": "eslint --fix -f visualstudio \"./src/**/*.ts\" 1>&2",
    "lint-deprecation": "eslint --fix -f visualstudio --no-inline-config -c ../../common/config/eslint/eslint.config.deprecation-policy.js \"./src/**/*.ts\"",
    "test": "npm run -s webpackTests && certa -r chrome",
    "webpackTests": "webpack --config ./src/test/utils/webpack-config.cjs 1>&2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iTwin/itwinjs-core.git",
    "directory": "extensions/frontend-tiles"
  },
  "keywords": [
    "Bentley",
    "BIM",
    "iModel"
  ],
  "author": {
    "name": "Bentley Systems, Inc.",
    "url": "http://www.bentley.com"
  },
  "peerDependencies": {
    "@itwin/core-bentley": "workspace:*",
    "@itwin/core-common": "workspace:*",
    "@itwin/core-frontend": "workspace:*",
    "@itwin/core-geometry": "workspace:*"
  },
  "devDependencies": {
    "@itwin/build-tools": "workspace:*",
    "@itwin/core-bentley": "workspace:*",
    "@itwin/certa": "workspace:*",
    "@itwin/core-common": "workspace:*",
    "@itwin/core-frontend": "workspace:*",
    "@itwin/core-geometry": "workspace:*",
    "@itwin/eslint-plugin": "catalog:linting",
    "@types/chai": "catalog:testing",
    "@types/chai-as-promised": "catalog:testing",
    "@types/mocha": "catalog:testing",
    "@types/node": "catalog:build",
    "@types/sinon": "catalog:testing",
    "babel-loader": "catalog:bundling",
    "babel-plugin-istanbul": "catalog:testing",
    "chai": "catalog:testing",
    "chai-as-promised": "catalog:testing",
    "eslint": "catalog:linting",
    "glob": "catalog:build",
    "internal-tools": "workspace:*",
    "mocha": "catalog:testing",
    "rimraf": "catalog:build",
    "sinon": "catalog:testing",
    "source-map-loader": "catalog:bundling",
    "typescript": "catalog:build",
    "webpack": "catalog:bundling"
  }
}
